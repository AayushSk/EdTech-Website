# Server Port
PORT=4000

# MongoDB Connection String (Replace with your local or MongoDB Atlas connection string)
DATABASE_URL=mongodb://127.0.0.1:27017/StudyNotion

# JWT Secret Key
JWT_SECRET=your_jwt_secret_here

# Cloudinary Configuration (For course videos and image uploads)
CLOUD_NAME=your_cloudinary_cloud_name
API_KEY=your_cloudinary_api_key
API_SECRET=your_cloudinary_api_secret
FOLDER_NAME=StudyNotion

# Razorpay Payment Gateway Credentials
RAZORPAY_KEY=rzp_test_your_razorpay_key
RAZORPAY_SECRET=your_razorpay_secret

# Nodemailer Configuration (For sending OTP and password reset emails)
MAIL_HOST=smtp.gmail.com
MAIL_USER=your_email@gmail.com
MAIL_PASS=your_email_app_password

